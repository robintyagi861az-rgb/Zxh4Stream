<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    
    <!-- Stylized Red Ribbon Z for Zxh4Stream -->
    <!-- Top Horizontal Ribbon Bar -->
    <path
        android:pathData="M28,30 L78,30 L74,40 L34,40 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="28"
                android:startY="30"
                android:endX="78"
                android:endY="40"
                android:type="linear">
                <item android:color="#FF1E27" android:offset="0.0" />
                <item android:color="#E50914" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Diagonal Ribbon Bar with Netflix-style 3D shadow/gradient -->
    <path
        android:pathData="M78,30 L38,76 L28,76 L68,30 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="78"
                android:startY="30"
                android:endX="28"
                android:endY="76"
                android:type="linear">
                <item android:color="#E50914" android:offset="0.0" />
                <item android:color="#B81D24" android:offset="0.5" />
                <item android:color="#831010" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Bottom Horizontal Ribbon Bar -->
    <path
        android:pathData="M28,68 L68,68 L74,78 L28,78 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="28"
                android:startY="68"
                android:endX="74"
                android:endY="78"
                android:type="linear">
                <item android:color="#B81D24" android:offset="0.0" />
                <item android:color="#E50914" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Streaming Play Triangle Accent in Center -->
    <path
        android:pathData="M52,48 L62,54 L52,60 Z"
        android:fillColor="#FFFFFF" />

</vector>
